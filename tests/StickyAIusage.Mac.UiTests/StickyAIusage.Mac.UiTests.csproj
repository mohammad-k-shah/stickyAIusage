<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders every macOS screen off-screen to PNG with Avalonia's headless
       platform and Skia (real text and drawing, no display needed). Catches
       XAML/binding errors that only show at runtime, and CI uploads the
       images for design review. Runs on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StickyAIusage.Mac\StickyAIusage.Mac.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The README pictures each project renders (one list for all three). -->
    <Compile Include="..\Shared\ReadmePictures.cs" Link="Shared\ReadmePictures.cs" />
  </ItemGroup>

</Project>
