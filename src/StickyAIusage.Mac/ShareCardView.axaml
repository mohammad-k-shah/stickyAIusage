<!-- The share card (Core ShareCardModel), drawn for an image, never shown in a
     window: 1200×630 (wide) or 1080×1350 (portrait). A Border, not a
     UserControl: it renders outside any window, where templates aren't
     applied. Its colors come from ShareCardPalette, the same as on Windows. -->
<Border xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="StickyAIusage.Mac.ShareCardView">
    <Grid>
        <!-- A thin accent line along the top edge. -->
        <Border x:Name="AccentLine" Height="6" VerticalAlignment="Top" />
        <DockPanel x:Name="Frame" Margin="56">

            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock x:Name="KickerText" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="TitleText" FontSize="44" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText" FontSize="22" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock x:Name="DateText" Grid.Column="1" FontSize="22" Margin="24,6,0,0" VerticalAlignment="Top" />
            </Grid>

            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Margin="0,24,0,0">
                <TextBlock x:Name="EstimateText" FontSize="17" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,24,0" />
                <StackPanel x:Name="FooterMark" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image x:Name="LogoImage" Width="36" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="FooterNameText" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock x:Name="FooterUrlText" FontSize="22" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- The body: gauges or the big number, then the pace line and the figures.
                 Wide: side by side; portrait: one above the other (set in code). -->
            <Grid x:Name="Body" Margin="0,32,0,0">
                <StackPanel x:Name="MainPanel" VerticalAlignment="Center">
                    <TextBlock x:Name="HeadlineText" FontSize="104" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeadlineNoteText" FontSize="24" Margin="4,0,0,0" TextWrapping="Wrap" />
                    <StackPanel x:Name="GaugesPanel" />
                </StackPanel>
                <StackPanel x:Name="SidePanel" VerticalAlignment="Center">
                    <TextBlock x:Name="PaceText" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,24" />
                    <StackPanel x:Name="StatsPanel" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Grid>
</Border>
