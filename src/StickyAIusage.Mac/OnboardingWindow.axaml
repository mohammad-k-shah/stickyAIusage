<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:StickyAIusage.Mac.Controls"
        x:Class="StickyAIusage.Mac.OnboardingWindow"
        Title="Welcome to Sticky AI Usage"
        Width="560" SizeToContent="Height" CanResize="False" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13">
    <Window.Styles>
        <Style Selector="TextBlock.stepTitle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style Selector="TextBlock.body">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- Footer: where you are, and the way on. -->
        <Grid DockPanel.Dock="Bottom" Margin="28,6,28,20" ColumnDefinitions="*,Auto">
            <TextBlock x:Name="StepCaptionText" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="BackButton" Content="Back" Classes="secondary" MinWidth="88" Click="Back_Click" />
                <Button x:Name="NextButton" Content="Next" Classes="primary" MinWidth="88" IsDefault="True" Click="Next_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Margin="28,24,28,10">
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                    <Grid>
                        <c:ProgressRing Width="28" Height="28" Thickness="3" Value="62"
                                        Stroke="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource StrongBorderBrush}" />
                        <TextBlock Text="$" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <TextBlock x:Name="WindowTitleText" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>

            <!-- Step 1: what the app reads -->
            <StackPanel x:Name="ReadsPanel">
                <TextBlock x:Name="ReadsTitleText" Classes="stepTitle" />
                <Border Classes="card" Padding="16,12">
                    <StackPanel>
                        <ItemsControl x:Name="ReadsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid Margin="0,3" ColumnDefinitions="18,*">
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Top" Margin="0,7,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" LineHeight="19" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NetworkLineText" Classes="body" Margin="0,10,0,0" FontSize="12" />
                        <Grid Margin="0,10,0,0" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="UpdateCheckLabel" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="UpdateCheck" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Step 2 (and the upgrade screen, and Connect from Health): connect the plugin -->
            <StackPanel x:Name="ConnectPanel">
                <TextBlock x:Name="ConnectTitleText" Classes="stepTitle" />
                <TextBlock x:Name="ConnectIntroText" Classes="body" Margin="0,0,0,10" />
                <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="12,9">
                    <TextBlock x:Name="CommandText" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap" />
                </Border>
                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="RunButton" Classes="primary" Click="Run_Click" />
                    <Button x:Name="CopyButton" Classes="secondary" Margin="8,0,0,0" Click="Copy_Click" />
                </WrapPanel>
                <TextBlock x:Name="CopyHintText" Classes="body" Margin="0,6,0,0" FontSize="12" />
                <Border x:Name="StatusBorder" Margin="0,12,0,0" CornerRadius="8" Padding="12,9" BorderThickness="1"
                        BorderBrush="{DynamicResource SubtleBorderBrush}" Background="{DynamicResource CardBrush}" IsVisible="False">
                    <Grid ColumnDefinitions="18,*">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" VerticalAlignment="Top" Margin="0,5,0,0" />
                        <TextBlock x:Name="StatusText" Grid.Column="1" TextWrapping="Wrap" LineHeight="19" />
                    </Grid>
                </Border>
                <TextBox x:Name="OutputBox" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="120"
                         FontFamily="{StaticResource MonoFont}" FontSize="11" IsVisible="False"
                         AutomationProperties.Name="What Claude Code printed" />
                <Button x:Name="LegacyLinkButton" Classes="link" HorizontalAlignment="Left" Margin="0,12,0,0" Click="LegacyLink_Click" />
                <Border x:Name="LegacyPanel" Margin="0,8,0,0" Classes="card" Padding="14,10" IsVisible="False">
                    <StackPanel>
                        <TextBlock x:Name="LegacyWarningText" Classes="body" FontSize="12" Foreground="{DynamicResource CautionBrush}" />
                        <Button x:Name="LegacyButton" Classes="secondary" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Legacy_Click" />
                        <TextBlock x:Name="LegacyChosenText" Classes="body" Margin="0,8,0,0" FontSize="12" IsVisible="False" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Step 3: make it yours -->
            <StackPanel x:Name="YoursPanel">
                <TextBlock x:Name="YoursTitleText" Classes="stepTitle" />
                <Border Classes="card" Padding="16,12">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="StartAtLoginLabel" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="StartAtLoginCheck" Grid.Column="1" VerticalAlignment="Center" IsChecked="True" />
                        </Grid>
                        <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="AlertsLabel" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="AlertsCheck" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="PlacementText" Classes="body" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock x:Name="FinishNoteText" Classes="body" Margin="2,10,0,0" FontSize="12" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
