<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:StickyAIusage.Mac.Controls"
        xmlns:vm="using:StickyAIusage.ViewModels"
        x:Class="StickyAIusage.Mac.WidgetWindow"
        Title="Sticky AI Usage"
        SystemDecorations="None"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">

    <Window.Styles>
        <Style Selector="Rectangle.pillDivider">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Margin" Value="9,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource StrongBorderBrush}" />
        </Style>
    </Window.Styles>


    <!-- The pill and the flyout are placed freely inside the window (their
         Margins are set in code from FlyoutPlacement), so the flyout can open
         above or below the pill and shift sideways to stay on screen. No top
         margin, so the pill can sit in the menu bar strip; the sides and
         bottom leave room for the drop shadows (the window is transparent). -->
    <Grid x:Name="RootGrid" Margin="12,0,12,16">

        <!-- ============ Collapsed pill ============ -->
        <!-- Drag anywhere on it to move it; a click without moving toggles the
             flyout; right-click for the menu. -->
        <Border x:Name="PillBorder" HorizontalAlignment="Left" VerticalAlignment="Top" Height="24" CornerRadius="12" Padding="9,0,2,0"
                Background="{DynamicResource StripBackground}" BorderBrush="{DynamicResource StrongBorderBrush}" BorderThickness="1"
                BoxShadow="{DynamicResource PillShadow}" Cursor="SizeAll">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="PauseMenuItem" Header="Pause live updates" Click="RunToggleButton_Click" />
                    <MenuItem Header="Settings…" Click="SettingsMenu_Click" />
                    <MenuItem Header="Reset widget position" Click="ResetMenu_Click" />
                    <Separator />
                    <MenuItem Header="Quit Sticky AI Usage" Click="QuitMenu_Click" />
                </ContextMenu>
            </Border.ContextMenu>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <StackPanel x:Name="UsageGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <c:ProgressRing x:Name="UsageRing" Width="14" Height="14" Thickness="2.2" Margin="0,0,7,0"
                                    VerticalAlignment="Center" Stroke="{DynamicResource GoodBrush}"
                                    TrackBrush="{DynamicResource StrongBorderBrush}" />
                    <TextBlock x:Name="PrimaryText" Text="—" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="SecondaryText" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <!-- Pace chip (WidgetViewModel.ForecastChipText): "- limit ~4:12 PM",
                         "→ $212"; colored by ForecastLevel in code. -->
                    <TextBlock x:Name="ForecastText" Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               IsVisible="False" />
                    <TextBlock x:Name="StaleText" Margin="6,0,0,0" FontSize="11" VerticalAlignment="Center" IsVisible="False"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                    <!-- "Codex 91%": another tool closer to its limit than Claude (WidgetViewModel.ExtraChips); filled in code. -->
                    <StackPanel x:Name="ExtraChipsPanel" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="False" />

                    <!-- Plan accounts: weekly window, remaining credits, last update. -->
                    <Rectangle x:Name="WeeklyDivider" Classes="pillDivider" />
                    <TextBlock x:Name="WeeklyText" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <Rectangle x:Name="CreditsDivider" Classes="pillDivider" />
                    <TextBlock x:Name="CreditsText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Rectangle x:Name="UpdatedDivider" Classes="pillDivider" />
                    <TextBlock x:Name="UpdatedText" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>

                <!-- Session lights (SessionLights): a dot per Claude Code session -
                     amber needs you, green working, grey ring done - and "+N";
                     one dot in the squeezed menu bar. Filled in code. -->
                <StackPanel x:Name="LightsGroup" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0"
                            IsVisible="False" Background="Transparent">
                    <StackPanel x:Name="LightsDots" Orientation="Horizontal" VerticalAlignment="Center" />
                    <TextBlock x:Name="LightsMoreText" Margin="3,0,0,0" FontSize="11" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="False" />
                </StackPanel>

                <!-- Day target (monthly cap only): today's spend, % of the daily
                     target and its own ring - each part optional in Settings. -->
                <Rectangle x:Name="DayDivider" Classes="pillDivider" IsVisible="False" />
                <StackPanel x:Name="DayGroup" Orientation="Horizontal" VerticalAlignment="Center" IsVisible="False">
                    <c:ProgressRing x:Name="DayRing" Width="14" Height="14" Thickness="2.2" Margin="0,0,7,0"
                                    VerticalAlignment="Center" Stroke="{DynamicResource GoodBrush}"
                                    TrackBrush="{DynamicResource StrongBorderBrush}" />
                    <TextBlock x:Name="DayLabel" Text="Today:" Margin="0,0,5,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="DayAmountText" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock x:Name="DayPercentText" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <Rectangle x:Name="PillDivider" Classes="pillDivider" />

                <StackPanel x:Name="SessionGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionLabel" Text="Session:" Margin="0,0,5,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock x:Name="SessionCostText" Text="—" FontSize="12.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>

                <Button x:Name="RunToggleButton" Classes="icon" Width="22" Height="22" Margin="6,0,0,0"
                        ToolTip.Tip="Pause live updates" Click="RunToggleButton_Click">
                    <PathIcon x:Name="RunToggleIcon" Data="{StaticResource PauseIcon}" Width="10" Height="10" />
                </Button>
                <Button x:Name="ExpandButton" Classes="icon" Width="22" Height="22"
                        ToolTip.Tip="Show sessions" Click="ExpandButton_Click">
                    <PathIcon x:Name="ExpandIcon" Data="{StaticResource ChevronDownIcon}" Width="11" Height="11" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ============ Flyout: sessions (above or below the pill) ============ -->
        <Border x:Name="ExpandedPanel" IsVisible="False" Width="500" HorizontalAlignment="Left" VerticalAlignment="Top"
                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                CornerRadius="12" BoxShadow="{DynamicResource FlyoutShadow}">
            <DockPanel Margin="10,12,6,4">

                <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="6,0,4,12">
                    <StackPanel>
                        <TextBlock x:Name="RangeTitleText" Text="Today's sessions" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="SessionsSummaryText" Text="Loading…" Margin="0,2,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2">
                            <!-- An image of today's usage for a post: Copy, Save, Post on X / LinkedIn / Bluesky. -->
                            <Button x:Name="ShareButton" Classes="icon" ToolTip.Tip="Share an image of today's usage"
                                    ToolTip.ShowOnDisabled="True" AutomationProperties.Name="Share" Click="ShareButton_Click">
                                <PathIcon Data="{StaticResource ShareIcon}" Width="13" Height="13" />
                            </Button>
                            <Button x:Name="ThemeToggleButton" Classes="icon" ToolTip.Tip="Switch to the light theme" Click="ThemeToggleButton_Click">
                                <PathIcon x:Name="ThemeToggleIcon" Data="{StaticResource MoonIcon}" Width="13" Height="13" />
                            </Button>
                            <Button x:Name="FlyoutRunToggleButton" Classes="icon" ToolTip.Tip="Pause live updates" Click="RunToggleButton_Click">
                                <PathIcon x:Name="FlyoutRunToggleIcon" Data="{StaticResource PauseIcon}" Width="11" Height="11" />
                            </Button>
                            <Button Classes="icon" ToolTip.Tip="Settings" Click="SettingsButton_Click">
                                <PathIcon Data="{StaticResource GearIcon}" Width="14" Height="14" />
                            </Button>
                        </StackPanel>
                        <!-- Date range: Today | 2d | 1w | 2w | 30d (SessionRange), filled in code. -->
                        <StackPanel x:Name="RangeTabs" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="1" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>

                <!-- What the last Share did ("Image copied. Paste it into your post."). -->
                <TextBlock x:Name="ShareStatusText" DockPanel.Dock="Top" IsVisible="False" Margin="6,-4,6,10"
                           FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                <!-- Notice (WidgetViewModel.Notice): sign in again, install the
                     plugin, or the one-time plugin tip - a message and a button
                     that copies its command (the same as on Windows). -->
                <Border x:Name="NoticeBar" DockPanel.Dock="Top" Classes="card" Padding="12,10" Margin="0,0,4,10" IsVisible="False">
                    <StackPanel>
                        <TextBlock x:Name="NoticeText" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Spacing="6">
                            <Button x:Name="ConnectNoticeButton" Classes="primary" Padding="12,3" FontSize="12" IsVisible="False"
                                    ToolTip.Tip="Install the Claude Code plugin with one click, or copy the command for Claude Code"
                                    Click="ConnectNoticeButton_Click" />
                            <Button x:Name="CopyNoticeButton" Classes="primary" Padding="12,3" FontSize="12"
                                    Click="CopyNoticeButton_Click" />
                            <Button x:Name="DismissNoticeButton" Classes="secondary" Content="Dismiss" Padding="12,3" FontSize="12"
                                    IsVisible="False" ToolTip.Tip="Don't show this tip again" Click="DismissNoticeButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Usage card: "Plan Usage Limits: <plan>", then one row for a
                     monthly cap, or 5-hour / weekly / credits rows for Pro or Max. -->
                <Border x:Name="SummaryCard" DockPanel.Dock="Top" Classes="card" Padding="12,10,12,3" Margin="0,0,4,10">
                    <StackPanel>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,9">
                            <TextBlock x:Name="SummaryTitleText" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock x:Name="SummaryUpdatedText" Grid.Column="1" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>
                        <!-- When the reading isn't current and no notice above covers it:
                             why, and at most one way forward (WidgetViewModel.Health). -->
                        <StackPanel x:Name="HealthPanel" Margin="0,0,0,9" IsVisible="False">
                            <TextBlock x:Name="HealthText" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button x:Name="HealthButton" Classes="secondary" Padding="12,3" FontSize="12"
                                    HorizontalAlignment="Left" Margin="0,8,0,0" Click="HealthButton_Click" />
                        </StackPanel>
                        <ItemsControl x:Name="SummaryRowsList" ItemTemplate="{StaticResource SummaryRowTemplate}" />
                    </StackPanel>
                </Border>

                <!-- The other tools (Codex): a card each under Claude's, with its title, where the
                     numbers come from, a message when it reports none, and the same rows
                     (WidgetViewModel.ProviderSections). -->
                <ItemsControl x:Name="ProviderSectionsList" DockPanel.Dock="Top" IsVisible="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProviderSection">
                            <Border Classes="card" Padding="12,10,12,3" Margin="0,0,4,10">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding UpdatedText}" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Grid>
                                    <TextBlock Text="{Binding SourceLabel}" Margin="0,2,0,0" FontSize="11"
                                               IsVisible="{Binding SourceLabel, Converter={x:Static c:Converters.NotEmpty}}"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding Message}" Margin="0,7,0,0" FontSize="11.5" TextWrapping="Wrap"
                                               IsVisible="{Binding Message, Converter={x:Static c:Converters.NotEmpty}}"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ItemsControl ItemsSource="{Binding Rows}" Margin="0,9,0,0"
                                                  ItemTemplate="{StaticResource SummaryRowTemplate}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Without the plugin there are no lights: one line says how to get them. -->
                <TextBlock x:Name="LightsHintText" DockPanel.Dock="Top" IsVisible="False" Margin="6,0,6,4"
                           FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
                <Button x:Name="LightsConnectButton" DockPanel.Dock="Top" Classes="link" IsVisible="False"
                        HorizontalAlignment="Left" Margin="2,0,6,10" Padding="4,2" FontSize="11.5" Click="LightsConnect_Click" />

                <TextBlock x:Name="NoSessionsText" DockPanel.Dock="Top" IsVisible="False" Margin="6,2,6,14"
                           FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />

                <!-- A newer version (Check for updates on, UpdateNotice): what's new on its release
                     page, and the command that updates this copy. Never installed by the app. -->
                <StackPanel x:Name="UpdatePanel" DockPanel.Dock="Bottom" IsVisible="False" Margin="4,8,10,8">
                    <Button x:Name="UpdateLinkButton" Classes="link" HorizontalAlignment="Left" Padding="2,2" FontSize="11.5"
                            Click="UpdateLink_Click" ToolTip.Tip="Opens the release page on GitHub" />
                    <TextBlock x:Name="UpdateHowText" Margin="2,2,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Grid x:Name="UpdateCommandRow" ColumnDefinitions="*,Auto" Margin="2,4,0,0">
                        <SelectableTextBlock x:Name="UpdateCommandText" FontFamily="Menlo,Consolas,monospace" FontSize="11"
                                             TextWrapping="Wrap" VerticalAlignment="Center"
                                             Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.Name="Update command" />
                        <Button x:Name="CopyUpdateButton" Grid.Column="1" Classes="secondary" Content="Copy" Padding="10,2"
                                FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" Click="CopyUpdate_Click"
                                ToolTip.Tip="Copy the update command" />
                    </Grid>
                </StackPanel>

                <ScrollViewer x:Name="SessionsScroller" MaxHeight="560" Padding="0,0,10,0">
                    <ItemsControl x:Name="SessionsList" ItemTemplate="{StaticResource SessionCardTemplate}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
