<Window x:Class="StickyAIusage.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:StickyAIusage.Controls"
        Title="Sticky AI Usage Settings"
        Width="500" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="4,0,0,8" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <!-- Segmented control (Appearance): one connected group, the selected
             segment filled with the accent. -->
        <Style x:Key="Segment" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Padding" Value="13,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="16,12" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Rectangle">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource SubtleBorderBrush}" />
        </Style>
        <Style x:Key="ThresholdLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="7,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <!-- The footer stays put; everything above it scrolls once the window
         reaches its maximum height (the screen's work area, set in code). -->
    <DockPanel TextElement.Foreground="{DynamicResource TextPrimaryBrush}"
               TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="13">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,14,24,22">
        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" MinWidth="88" Click="Cancel_Click" />
        <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" MinWidth="88"
                Margin="8,0,0,0" Click="Save_Click" />
    </StackPanel>
    <ScrollViewer Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24,20,24,8">

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
            <Border Width="42" Height="42" CornerRadius="10" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                <Grid>
                    <c:ProgressRing Width="28" Height="28" Thickness="3" Value="62"
                                    Stroke="{DynamicResource AccentBrush}" TrackBrush="{DynamicResource StrongBorderBrush}" />
                    <TextBlock Text="$" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" />
                <TextBlock Text="Sticky AI Usage · Claude usage at a glance" FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Widget -->
        <!-- Appearance -->
        <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,18">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Theme" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="Follow your Windows app appearance, or pin light or dark. Applies straight away."
                               Style="{StaticResource RowHint}" />
                </StackPanel>
                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="8" Padding="2"
                        Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="ThemeSystemButton" Style="{StaticResource Segment}" Content="Auto" Click="Theme_Click" />
                        <ToggleButton x:Name="ThemeLightButton" Style="{StaticResource Segment}" Content="Light" Click="Theme_Click" />
                        <ToggleButton x:Name="ThemeDarkButton" Style="{StaticResource Segment}" Content="Dark" Click="Theme_Click" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock Text="Widget" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,18">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Usage" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Monthly spend and % of your cap, or your plan's 5-hour and weekly limits" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <CheckBox x:Name="ShowMonthlySpendCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center" AutomationProperties.Name="Show usage" />
                </Grid>
                <Rectangle Style="{StaticResource RowDivider}" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Current session cost" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Estimated cost of your most recent Claude Code session" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <CheckBox x:Name="ShowSessionCostCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center" AutomationProperties.Name="Show current session cost" />
                </Grid>
                <Rectangle Style="{StaticResource RowDivider}" />

                <!-- Day target: monthly spend cap only. Turned off (with a note)
                     on plans with rolling 5-hour and weekly limits. -->
                <StackPanel x:Name="DayTargetSection">
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Day target" Style="{StaticResource RowTitle}" />
                            <TextBlock Text="Approximate spend today against a daily target you set" Style="{StaticResource RowHint}" />
                        </StackPanel>
                        <CheckBox x:Name="ShowDayTargetCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                  VerticalAlignment="Center" AutomationProperties.Name="Show day target"
                                  Checked="DayTarget_Changed" Unchecked="DayTarget_Changed" />
                    </Grid>

                    <StackPanel x:Name="DayTargetOptions" Margin="32,0,16,12">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Daily target" Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="$" Margin="0,0,6,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="DayTargetBox" Grid.Column="2" Style="{StaticResource NumberBox}" Width="76"
                                     AutomationProperties.Name="Daily target in dollars" />
                        </Grid>
                        <TextBlock x:Name="DayTargetError" Visibility="Collapsed" Margin="0,-4,0,10" FontSize="11.5"
                                   TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" />
                        <TextBlock Text="Show on the widget" FontSize="11.5" Margin="0,0,0,6"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Amount spent today ($)" VerticalAlignment="Center" />
                            <CheckBox x:Name="ShowDayAmountCheck" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Show amount spent today" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="% of target" VerticalAlignment="Center" />
                            <CheckBox x:Name="ShowDayPercentCheck" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Show percent of day target" />
                        </Grid>
                        <Grid>
                            <TextBlock Text="Progress ring" VerticalAlignment="Center" />
                            <CheckBox x:Name="ShowDayRingCheck" HorizontalAlignment="Right" Style="{StaticResource ToggleSwitch}"
                                      AutomationProperties.Name="Show day target progress ring" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="DayTargetNote" Visibility="Collapsed" Margin="16,0,16,12" Style="{StaticResource RowHint}"
                           Foreground="{DynamicResource CautionBrush}" />
            </StackPanel>
        </Border>

        <!-- Spend alerts -->
        <!-- Session cards -->
        <TextBlock Text="Session cards" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,18">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Fields on each card" Style="{StaticResource RowTitle}" />
                    <TextBlock x:Name="FieldsSummary" Style="{StaticResource RowHint}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Customize…" Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center" Click="CustomizeFields_Click" />
            </Grid>
        </Border>

        <TextBlock Text="Usage alerts" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="The usage ring changes color as you use more of your cap or plan limits."
                           Style="{StaticResource RowHint}" Margin="0,0,0,14" />

                <!-- Live preview of the four zones, sized by the thresholds. -->
                <Grid x:Name="ZoneBar" Height="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="GreenZone" Width="50*" />
                        <ColumnDefinition x:Name="YellowZone" Width="30*" />
                        <ColumnDefinition x:Name="OrangeZone" Width="15*" />
                        <ColumnDefinition x:Name="RedZone" Width="5*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="4,0,0,4" Margin="0,0,1,0" Background="{DynamicResource GoodBrush}" />
                    <Border Grid.Column="1" Margin="1,0" Background="{DynamicResource WarnBrush}" />
                    <Border Grid.Column="2" Margin="1,0" Background="{DynamicResource CautionBrush}" />
                    <Border Grid.Column="3" CornerRadius="0,4,4,0" Margin="1,0,0,0" Background="{DynamicResource DangerBrush}" />
                </Grid>
                <Grid Margin="0,4,0,16">
                    <TextBlock Text="0%" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="100%" FontSize="10.5" HorizontalAlignment="Right" Foreground="{DynamicResource TextTertiaryBrush}" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="YellowBox" Style="{StaticResource NumberBox}" AutomationProperties.Name="Yellow threshold percent" />
                        <Ellipse Width="8" Height="8" Margin="10,0,0,0" Fill="{DynamicResource WarnBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Yellow" Style="{StaticResource ThresholdLabel}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBox x:Name="OrangeBox" Style="{StaticResource NumberBox}" AutomationProperties.Name="Orange threshold percent" />
                        <Ellipse Width="8" Height="8" Margin="10,0,0,0" Fill="{DynamicResource CautionBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Orange" Style="{StaticResource ThresholdLabel}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <TextBox x:Name="RedBox" Style="{StaticResource NumberBox}" AutomationProperties.Name="Red threshold percent" />
                        <Ellipse Width="8" Height="8" Margin="10,0,0,0" Fill="{DynamicResource DangerBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="Red" Style="{StaticResource ThresholdLabel}" />
                    </StackPanel>
                </Grid>

                <TextBlock x:Name="ThresholdError" Visibility="Collapsed" Margin="0,10,0,0" FontSize="11.5"
                           Foreground="{DynamicResource DangerBrush}" />
            </StackPanel>
        </Border>

        <!-- General -->
        <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
        <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Launch the widget automatically when you sign in" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <CheckBox x:Name="StartWithWindowsCheck" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              VerticalAlignment="Center" AutomationProperties.Name="Start with Windows" />
                </Grid>
                <Rectangle Style="{StaticResource RowDivider}" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Widget position" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Move the widget back next to the system tray" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Reset" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                            Click="ResetPosition_Click" />
                </Grid>
                <Rectangle Style="{StaticResource RowDivider}" />
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Diagnostics" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="Logs help troubleshoot usage or sign-in problems" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open log folder" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center"
                            Click="OpenLogFolder_Click" />
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
    </ScrollViewer>
    </DockPanel>
</Window>
