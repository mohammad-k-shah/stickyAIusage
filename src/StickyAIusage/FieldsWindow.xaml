<Window x:Class="StickyAIusage.FieldsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Session Card Fields"
        WindowState="Maximized"
        Width="1100" Height="820" MinWidth="740" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="2,0,0,8" />
        </Style>
        <Style x:Key="PaneHeading" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="PaneHeadingText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,18,20,18">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Session card fields" FontSize="19" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,3,0,0"
                       Text="Pick what each session card shows in the panel. Drag a chip to reorder it or drop it in another row; a chip always takes the color of its place in the row." />
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <Button Content="Reset to defaults" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                    Click="Reset_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" MinWidth="88" IsCancel="True"
                        Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="88" IsDefault="True"
                        Click="Save_Click" />
            </StackPanel>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="266" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Catalog -->
            <DockPanel Grid.Column="0">
                <TextBlock x:Name="CatalogTitle" DockPanel.Dock="Top" Text="Available fields" Style="{StaticResource Section}" />
                <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,6" FontSize="12.5"
                         Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1"
                         TextChanged="Search_TextChanged" />
                <Border Style="{StaticResource Card}" Padding="4,2,4,8">
                    <ScrollViewer Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="CatalogPanel" />
                    </ScrollViewer>
                </Border>
            </DockPanel>

            <!-- Layout and preview. A grid, not a dock panel: the rows and
                 the preview each get a share of the height and scroll inside
                 it, so a card with many fields can't push either off-screen. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource PaneHeading}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ON THE CARD" Style="{StaticResource PaneHeadingText}" />
                        <!-- Why a drop was refused. It shows for a few seconds
                             and then goes away on its own. -->
                        <StackPanel x:Name="RowFullNotice" Orientation="Horizontal"
                                    Visibility="Collapsed" Margin="14,0,0,0">
                            <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="11.5"
                                       Margin="0,0,5,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource CautionBrush}" />
                            <TextBlock x:Name="RowFullNoticeText" FontSize="11.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RowsPanel" />
                </ScrollViewer>

                <!-- Always visible under the rows, however far they scroll. -->
                <ContentControl x:Name="NewRowHost" Grid.Row="2" />

                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12,4" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Context bar" />
                                <TextBlock Text="The context window bar under the chips" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <CheckBox x:Name="ContextBarToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Checked="Blocks_Changed" Unchecked="Blocks_Changed" />
                        </Grid>
                        <Rectangle Height="1" Fill="{DynamicResource SubtleBorderBrush}" />
                        <Grid Margin="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Git line" />
                                <TextBlock Text="Branch, changes, ±lines, PR and CI, laid out in one line" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <CheckBox x:Name="GitDetailsToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                      VerticalAlignment="Center" Checked="Blocks_Changed" Unchecked="Blocks_Changed" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource Card}" Padding="12,10">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PaneHeading}">
                            <TextBlock Text="PREVIEW" Style="{StaticResource PaneHeadingText}" />
                        </Border>
                        <ScrollViewer Style="{StaticResource OverlayScrollViewer}" VerticalScrollBarVisibility="Auto">
                            <ContentControl x:Name="PreviewCard" ContentTemplate="{StaticResource SessionCardTemplate}" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
