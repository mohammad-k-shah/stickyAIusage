<Application x:Class="StickyAIusage.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the color palette, swapped at runtime by
                     Services/ThemeService.cs; Theme.xaml's styles reference it
                     with DynamicResource. -->
                <ResourceDictionary Source="/StickyAIusage;component/Themes/Tokens.Dark.xaml" />
                <ResourceDictionary Source="/StickyAIusage;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
